# Postgres
DATABASE_URL=postgresql+psycopg://localhost/work_cube

# Model backend — provider-agnostic via LiteLLM. Defaults to local Ollama,
# no API key required. Override with any LiteLLM-supported model string
# (e.g. "anthropic/claude-3-5-sonnet-20241022", "openai/gpt-4o") and the
# matching provider API key (ANTHROPIC_API_KEY / OPENAI_API_KEY / etc,
# read automatically by litellm) to use a hosted model instead.
WORK_CUBE_LLM_MODEL=ollama/llama3.2:1b
WORK_CUBE_EMBEDDING_MODEL=ollama/nomic-embed-text
OLLAMA_API_BASE=http://localhost:11434
